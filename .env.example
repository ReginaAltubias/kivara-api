APP_NAME=KIVARA
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================================
# DATABASE - PostgreSQL (via PgBouncer connection pool)
# ============================================================================
DB_CONNECTION=pgsql
DB_HOST=pgbouncer
DB_PORT=6432
DB_DATABASE=kivara
DB_USERNAME=postgres
DB_PASSWORD=secret

# ============================================================================
# CACHE & SESSION - Redis
# ============================================================================
CACHE_DRIVER=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ============================================================================
# QUEUE - Background Jobs via Redis
# ============================================================================
QUEUE_CONNECTION=redis

# ============================================================================
# MAIL
# ============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@kivara.ao"
MAIL_FROM_NAME="KIVARA"

# ============================================================================
# BROADCAST & FILESYSTEM
# ============================================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ============================================================================
# AWS (opcional)
# ============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================================
# VITE
# ============================================================================
VITE_APP_NAME="${APP_NAME}"

# Segredo HMAC dos webhooks de pagamento (sem ele os webhooks respondem 503)
PAYMENT_WEBHOOK_SECRET=

# Origens CORS permitidas (separadas por virgulas). Omitir usa FRONTEND_URL + localhost/Capacitor.
CORS_ALLOWED_ORIGINS=
