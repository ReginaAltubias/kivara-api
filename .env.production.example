################################################################################
# KIVARA API - Production Environment Configuration
################################################################################

# ============================================================================
# Application
# ============================================================================
APP_NAME=KIVARA
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:YOUR_APP_KEY_HERE_GENERATE_WITH_php_artisan_key_generate
APP_TIMEZONE=Africa/Luanda
APP_URL=https://api.kivara.ao

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_BR

# ============================================================================
# Database - PostgreSQL (Production)
# ============================================================================
DB_CONNECTION=pgsql
DB_HOST=postgres.production.internal
DB_PORT=5432
DB_DATABASE=kivara_prod
DB_USERNAME=postgres_prod_user
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE
DB_SSLMODE=require

# Connection pooling (PgBouncer optional)
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================================
# Cache - Redis
# ============================================================================
CACHE_DRIVER=redis
CACHE_STORE=redis
REDIS_HOST=redis.production.internal
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_SECURE_REDIS_PASSWORD
REDIS_CLIENT=phpredis
REDIS_CONNECTION_POOL_SIZE=10

# ============================================================================
# Session Management
# ============================================================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.kivara.ao
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=strict

# ============================================================================
# Queue Processing
# ============================================================================
QUEUE_CONNECTION=redis
QUEUE_TIMEOUT=60
QUEUE_RETRY_AFTER=90

# ============================================================================
# Mail Configuration
# ============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=SG.CHANGE_ME_YOUR_SENDGRID_API_KEY
MAIL_FROM_ADDRESS=noreply@kivara.ao
MAIL_FROM_NAME="KIVARA"

# ============================================================================
# AWS S3 (File Storage)
# ============================================================================
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=kivara-uploads-prod
AWS_URL=https://cdn.kivara.ao
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================================
# Logging
# ============================================================================
LOG_CHANNEL=stack
LOG_STACK=single,sentry
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Sentry (Error tracking)
SENTRY_LARAVEL_DSN=https://CHANGE_ME@sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=production

# ============================================================================
# Security - CORS
# ============================================================================
CORS_ALLOWED_ORIGINS=https://app.kivara.ao,https://www.kivara.ao
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=X-Total-Count
CORS_MAX_AGE=86400

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=1

# ============================================================================
# Authentication - Sanctum (JWT)
# ============================================================================
SANCTUM_STATEFUL_DOMAINS=app.kivara.ao,www.kivara.ao
SANCTUM_TOKEN_EXPIRATION=10080

# ============================================================================
# Third-Party Integrations
# ============================================================================

# Firebase (Push Notifications)
FIREBASE_API_KEY=CHANGE_ME_FIREBASE_KEY
FIREBASE_AUTH_DOMAIN=kivara.firebaseapp.com
FIREBASE_PROJECT_ID=kivara-prod

# OneSignal (Alternative Push)
ONESIGNAL_APP_ID=CHANGE_ME_ONESIGNAL_APP_ID
ONESIGNAL_REST_API_KEY=CHANGE_ME_ONESIGNAL_API_KEY

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_PARENTAL_GATE=true
FEATURE_GAMIFICATION=true
FEATURE_LEADERBOARDS=false
FEATURE_ANALYTICS=true

# ============================================================================
# Performance & Optimization
# ============================================================================
PHP_CLI_SERVER_WORKERS=8
OPCACHE_ENABLE=1
OPCACHE_MEMORY_CONSUMPTION=128
OPCACHE_INTERNED_STRINGS_BUFFER=8

# Database Query Logging (Disabled in production)
DB_QUERY_LOG=false

# Asset Compression
ASSET_COMPRESSION_ENABLED=true

# ============================================================================
# Monitoring & Health Checks
# ============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60

# Datadog APM
DD_TRACE_ENABLED=true
DD_ENV=production
DD_SERVICE=kivara-api
DD_VERSION=1.0.0

# ============================================================================
# Backup Configuration
# ============================================================================
BACKUP_DRIVER=s3
BACKUP_S3_BUCKET=kivara-backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_CRON="0 2 * * *"

################################################################################
# ⚠️ WARNING: Never commit this file to version control!
# Use environment management tools:
# - HashiCorp Vault
# - AWS Secrets Manager
# - Google Cloud Secret Manager
# - GitHub Secrets (for Actions)
################################################################################
